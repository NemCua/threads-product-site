{$TOOLVIDEOS_DOMAIN} {
    encode zstd gzip

    root * /srv/toolvideos
    try_files {path} {path}.html {path}/ {path}/index.html
    file_server

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
}
